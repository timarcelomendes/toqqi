# Conexão da aplicação: papel SEM superusuário e SEM BYPASSRLS (o RLS depende disso)
DATABASE_URL=postgresql+psycopg://toqqi_app:toqqi_app@localhost:5432/toqqi_dev
# Conexão das migrações: papel dono das tabelas
MIGRATION_DATABASE_URL=postgresql+psycopg://toqqi:toqqi@localhost:5432/toqqi_dev
# Nome do papel da aplicação que recebe GRANTs nas migrações (padrão: toqqi_app)
APP_DB_ROLE=toqqi_app
AUTO_MIGRATE=1

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173

# console | memory | zeptomail | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Toqqi <nao-responda@toqqi.com>"
ZEPTOMAIL_TOKEN=
RESEND_API_KEY=

# desenvolvimento | producao (em produção o provedor console não vale para envios de pesquisa)
AMBIENTE=desenvolvimento
# Segredo de POST /api/v1/interno/tarefas (agendador externo, a cada hora). Vazio = rota desligada.
TAREFAS_TOKEN=

# Cifra os segredos guardados no banco (token do WhatsApp, segredos de webhooks). Obrigatória em produção.
SEGREDOS_KEY=
# WhatsApp automático (Cloud API da Meta)
WHATSAPP_GRAPH_VERSION=v23.0
# Token de verificação do webhook (colado no painel da Meta) e App Secret do app da Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# IA por resposta (OpenAI). A chave é da plataforma; em produção fica no painel do Render (Environment) de
# toqqi-api E toqqi-tarefas, nunca no render.yaml. Vazia = sem IA (temas por palavras-chave).
OPENAI_API_KEY=
# openai | memoria (testes) | desligado
IA_PROVEDOR=openai
IA_MODELO=gpt-5-mini
# reasoning.effort enviado à OpenAI (vazio = não manda)
IA_ESFORCO=minimal
IA_BASE_URL=https://api.openai.com
# Etapa 5g: as variáveis de cota da cortesia, dos níveis de modelo e da exclusão automática abaixo são só o PADRÃO;
# o que a equipe Toqqi salvar em Plataforma › Parâmetros vale mais.
# Assistente (cada pergunta gasta as análises do nível, da cota do plano) e cota das contas em cortesia
IA_ASSISTENTE_MODELO=gpt-5-mini
IA_ASSISTENTE_ESFORCO=low
IA_COTA_CORTESIA=500
# Níveis de modelo de Configurações › IA (assistente, resumo do painel, parecer dos relatórios e passos das ações).
# Esforço vazio = não manda reasoning; no Equilibrado (o padrão das contas), vazios = os do assistente.
# Trocou o modelo? Confira o esforço: "minimal" só existe na família gpt-5 (nos 5.1 em diante, use "none").
IA_MODELO_RAPIDO=gpt-5-nano
IA_ESFORCO_RAPIDO=minimal
IA_MODELO_EQUILIBRADO=
IA_ESFORCO_EQUILIBRADO=
IA_MODELO_DETALHADO=gpt-5
IA_ESFORCO_DETALHADO=low

# Cobrança (Asaas). Em produção, só no painel do Render: ASAAS_API_KEY em toqqi-api E toqqi-tarefas,
# ASAAS_WEBHOOK_TOKEN só em toqqi-api (32 a 255 caracteres, sem espaços, diferente da chave). Nunca no render.yaml.
# Vazias = sem cobrança online. ASAAS_URL só para o Asaas falso local (http://localhost:8010/v3).
# A chave define o ambiente ($aact_prod_… = produção; qualquer outra = sandbox). Trocar de sandbox para
# produção: README, "Trocar a chave do sandbox para a produção".
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_URL=

# E-mails com acesso à área da plataforma, separados por vírgula
SUPERADMIN_EMAILS=

# 0 desliga o limite de tentativas (só para testes)
RATE_LIMIT_ENABLED=1

# IP do cliente: cabeçalho posto pelo proxy da frente (Render + Cloudflare: CF-Connecting-IP); vazio = a conexão
IP_CLIENTE_CABECALHO=

# Exclusão automática das contas encerradas (tarefa limpeza): ligada (avisa e exclui) ou simular (só conta e registra
# no log); qualquer outro valor também só simula, com um aviso no log
EXCLUSAO_AUTOMATICA=simular

# Produção (Render): com APP_DB_PASSWORD, a API cria o papel restrito sozinha usando DATABASE_URL (dono)
# APP_DB_ROLE=toqqi_app
# APP_DB_PASSWORD=
# Primeiro acesso: cria a conta "Toqqi" e este admin (e-mail já confirmado), se ainda não existir
# ADMIN_INICIAL_EMAIL=
# ADMIN_INICIAL_SENHA=
