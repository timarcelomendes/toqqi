# Conexão da aplicação: papel SEM superusuário e SEM BYPASSRLS (o RLS depende disso)
DATABASE_URL=postgresql+psycopg://toqqi_app:toqqi_app@localhost:5432/toqqi_dev
# Conexão das migrações: papel dono das tabelas
MIGRATION_DATABASE_URL=postgresql+psycopg://toqqi:toqqi@localhost:5432/toqqi_dev
# Nome do papel da aplicação que recebe GRANTs nas migrações (padrão: toqqi_app)
APP_DB_ROLE=toqqi_app
AUTO_MIGRATE=1

# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:5173

# console | memory | zeptomail | resend
EMAIL_PROVIDER=console
EMAIL_FROM="Toqqi <nao-responda@toqqi.com>"
ZEPTOMAIL_TOKEN=
RESEND_API_KEY=

# desenvolvimento | producao (em produção o provedor console não vale para envios de pesquisa)
AMBIENTE=desenvolvimento
# Segredo de POST /api/v1/interno/tarefas (agendador externo, a cada hora). Vazio = rota desligada.
TAREFAS_TOKEN=

# Cifra os segredos guardados no banco (token do WhatsApp, segredos de webhooks). Obrigatória em produção.
SEGREDOS_KEY=
# WhatsApp automático (Cloud API da Meta)
WHATSAPP_GRAPH_VERSION=v23.0
# Token de verificação do webhook (colado no painel da Meta) e App Secret do app da Meta
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# E-mails com acesso à área da plataforma, separados por vírgula
SUPERADMIN_EMAILS=

# 0 desliga o limite de tentativas (só para testes)
RATE_LIMIT_ENABLED=1

# Produção (Render): com APP_DB_PASSWORD, a API cria o papel restrito sozinha usando DATABASE_URL (dono)
# APP_DB_ROLE=toqqi_app
# APP_DB_PASSWORD=
# Primeiro acesso: cria a conta "Toqqi" e este admin (e-mail já confirmado), se ainda não existir
# ADMIN_INICIAL_EMAIL=
# ADMIN_INICIAL_SENHA=
